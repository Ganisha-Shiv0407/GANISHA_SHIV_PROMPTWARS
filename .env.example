# GEMINI_API_KEY: Required for Gemini AI API calls on the Express backend.
# In AI Studio, configure this via the Settings > Secrets panel or in a local .env file.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# ADMIN_PASSCODE: Passcode for the privacy-conscious Admin Console.
ADMIN_PASSCODE=blindspot-admin-2026

# PORT: Port for the Express + Vite server.
PORT=3000
